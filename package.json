{
  "name": "fast-class-transformer",
  "version": "1.1.1",
  "description": "A zero-dependency, ahead-of-time (AoT) compiled, ultra-fast alternative to class-transformer for TypeScript and NestJS.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nestjs": {
      "import": "./dist/nestjs/index.js",
      "types": "./dist/nestjs/index.d.ts",
      "default": "./dist/nestjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "bun run build && bun test",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "benchmark": "bun run benchmark.ts",
    "benchmark:nestjs": "bun run benchmark-nestjs.ts"
  },
  "keywords": [
    "class-transformer",
    "nestjs",
    "typescript",
    "validation",
    "mapping",
    "fast",
    "performance",
    "aot"
  ],
  "author": "Mohit",
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
    "class-validator": ">=0.14.0",
    "typescript": ">=4.5.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^12.1.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jest": "^29.7.0",
    "mitata": "^1.0.34",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
